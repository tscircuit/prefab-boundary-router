{
  "name": "@tscircuit/prefab-boundary-router",
  "version": "0.0.12",
  "description": "A* breakout-boundary router with paired via escapes and negotiated rip-up",
  "type": "module",
  "module": "lib/index.ts",
  "license": "MIT",
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/prefab-boundary-router.git"
  },
  "homepage": "https://prefab-boundary-router.vercel.app",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "import": "./lib/index.ts",
      "types": "./lib/index.ts"
    }
  },
  "scripts": {
    "build": "bunx tsc --noEmit",
    "build:site": "cosmos-export",
    "test": "bun run setup:test-deps && bun test",
    "setup:test-deps": "bun run --cwd node_modules/sharp install",
    "generate:stress-dataset": "bun benchmarks/generate-stress-dataset.ts",
    "benchmark:stress": "bun benchmarks/run-stress-benchmark.ts",
    "generate:production-stress-dataset": "bun benchmarks/generate-production-stress-dataset.ts",
    "benchmark:production-stress": "bun benchmarks/run-stress-benchmark.ts production",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "cosmos",
    "dev": "cosmos"
  },
  "dependencies": {
    "@tscircuit/hypergraph": "^0.0.71",
    "@tscircuit/solver-utils": "^0.0.16",
    "graphics-debug": "^0.0.86"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "latest",
    "@types/react": "^19.1.13",
    "bun-match-svg": "^0.0.15",
    "react": "^19.1.1",
    "react-cosmos": "^7.1.1",
    "react-cosmos-plugin-vite": "^7.1.1",
    "react-dom": "^19.1.1",
    "sharp": "0.32.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "trustedDependencies": [
    "sharp"
  ]
}
